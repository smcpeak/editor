// check-table-widget.uis
// Test the CheckTableWidget* commands, using the Table dialog.

{
  cmds: [

CheckFocusWidget("mainWindow.central.clickButton")

Shortcut("mainWindow.menuBar.dialogsMenu.tableAction" "F3")
CheckFocusWindow("tableDialog")
CheckFocusWidget("tableDialog.table")

CheckTableWidgetRowCount("tableDialog.table" 3)
CheckTableWidgetRow("tableDialog.table" 1 ["beta" "2"])
CheckTableWidgetContents("tableDialog.table" [
  ["alpha" "1"]
  ["beta"  "2"]
  [re("^gam") "3"]
])
CheckTableWidgetCellMatches("tableDialog.table" 2 0 "mm")
CheckTableWidgetCurrentRow("tableDialog.table" 0)

// Arrow keys move the current row.
KeyPress("tableDialog.table" "Key_Down" "")
CheckTableWidgetCurrentRow("tableDialog.table" 1)
KeyPress("tableDialog.table" "Key_Down" "")
CheckTableWidgetCurrentRow("tableDialog.table" 2)
KeyPress("tableDialog.table" "Key_Up" "")
CheckTableWidgetCurrentRow("tableDialog.table" 1)

// Adding a row makes it current.
ClickButton("tableDialog.addRowButton")
CheckTableWidgetRowCount("tableDialog.table" 4)
CheckTableWidgetRow("tableDialog.table" 3 ["row 4" "4"])
CheckTableWidgetCurrentRow("tableDialog.table" 3)

// Wrong expected values.
CheckFails(
  CheckTableWidgetRowCount("tableDialog.table" 3)
  "should have been 3 but was 4")
CheckFails(
  CheckTableWidgetRow("tableDialog.table" 0 ["alpha" "2"])
  "should have been \\[\"alpha\" \"2\"\\] but was")
CheckFails(
  CheckTableWidgetContents("tableDialog.table" [
    ["alpha" "1"]
    ["beta"  "2"]
    ["gamma" "3"]
  ])
  "numRows: mismatch")
CheckFails(
  CheckTableWidgetContents("tableDialog.table" [
    ["alpha" "1"]
    ["beta"  "X"]
    ["gamma" "3"]
    ["row 4" "4"]
  ])
  "cell text: mismatch")
CheckFails(
  CheckTableWidgetContents("tableDialog.table" [
    [re("^b") "1"]
    ["beta"  "2"]
    ["gamma" "3"]
    ["row 4" "4"]
  ])
  "re match fail")
CheckFails(
  CheckTableWidgetCellMatches("tableDialog.table" 0 0 "^b")
  "the actual string \"alpha\" did not match the regex \"\\^b\"")
CheckFails(
  CheckTableWidgetCurrentRow("tableDialog.table" 0)
  "should have been 0 but was 3")

ClickButton("tableDialog.closeButton")
CheckFocusWindow("mainWindow")

  ]
}

// EOF
