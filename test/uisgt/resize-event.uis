// resize-event.uis
// Test ResizeEvent and CheckSize.

{
  cmds: [

CheckFocusWidget("mainWindow.central.clickButton")

// The sizes are above the window's minimum size; see the comment in
// `UIShellGUICommandHandler::resizeChildWidget`.
ResizeEvent("mainWindow.central.notes" QSize(400 150))
CheckSize("mainWindow.central.notes" QSize(400 150))

ResizeEvent("mainWindow.central.notes" QSize(450 200))
CheckSize("mainWindow.central.notes" QSize(450 200))

CheckFails(
  CheckSize("mainWindow.central.notes" QSize(400 150))
  "should have been QSize\\(400 150\\) but was QSize\\(450 200\\)")

// The pad has a fixed size.
CheckSize("mainWindow.central.mousePad" QSize(100 100))

// A widget in a second top-level window.
Shortcut("mainWindow.menuBar.windowsMenu.listWindowAction" "F4")
CheckFocusWindow("mainWindow.listWindow")

ResizeEvent("mainWindow.listWindow.list" QSize(320 240))
CheckSize("mainWindow.listWindow.list" QSize(320 240))

ResizeEvent("mainWindow.listWindow.list" QSize(360 260))
CheckSize("mainWindow.listWindow.list" QSize(360 260))

// The list view's height is fixed, but its width follows the list's.
CheckSize("mainWindow.listWindow.listView" QSize(360 80))

// Resizing the List Window does not affect the main window.
CheckSize("mainWindow.central.notes" QSize(450 200))

  ]
}

// EOF
