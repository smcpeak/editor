// all-uisgt-tests.gdvn
// List of all ui-shell-gui-test command lines to run in succession.

[
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/empty.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/key-press.uis" ]
  [ "./ui-shell-gui-test.exe"
    "-uisCmds=test/uisgt/focus-key-press-release.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/focus-key-pr.uis" ]
  [ "./ui-shell-gui-test.exe"
    "-uisCmds=test/uisgt/focus-key-sequence.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/shortcut.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/set-focus.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/resize-event.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/trigger-action.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/click-button.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/mouse-buttons.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/mouse-move.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/check-label.uis" ]
  [ "./ui-shell-gui-test.exe"
    "-uisCmds=test/uisgt/wait-until-check-label.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/check-combo-box.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/check-text-edit.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/check-clipboard.uis" ]
  [ "./ui-shell-gui-test.exe" "-uisCmds=test/uisgt/check-query.uis" ]
]

// EOF
