// all-tests.gdvn
// List of all GUI test command lines to run in succession.

[
  [ "./editor.exe" "-uisCmds=test/down.uis" ]
  [ "./editor.exe" "-uisCmds=test/copy-paste.uis" ]
  [ "./editor.exe" "-uisCmds=test/file-open-dialog1.uis" ]
  [ "./editor.exe" "-uisCmds=test/file-open-nonexist.uis" ]

  // This test touches `gets-modified.txt`, making it relatively recent
  // by the time we run the second test, below, that uses that file.
  // Therefore, this test is run near the start, so time can elapse
  // between them.  The test will work even if they are adjacent, but a
  // sleep typically gets activated in that case.
  [ "./editor.exe" "-uisCmds=test/reload-after-modification.uis" ]

  [ "./editor.exe" "-uisCmds=test/simple-text-ins.uis" ]
  [ "./editor.exe" "-uisCmds=test/sar-find-cs-completion.uis" ]
  [ "./editor.exe" "-uisCmds=test/sar-repl-cs-completion.uis" ]
  [ "./editor.exe" "-uisCmds=test/sar-match-limit.uis" ]
  [ "./editor.exe" "-uisCmds=test/sar-replace-bol.uis" ]
  [ "./editor.exe" "-uisCmds=test/resize1.uis" ]
  [ "./editor.exe" "-uisCmds=test/read-only1.uis" ]
  [ "./editor.exe" "-uisCmds=test/read-only2.uis" ]
  [ "./editor.exe" "-uisCmds=test/read-only3.uis" ]
  [ "./editor.exe" "-uisCmds=test/prompt-unsaved-changes.uis" ]
  [ "./editor.exe" "-uisCmds=test/screenshot1.uis" ]
  [ "./editor.exe" "-uisCmds=test/visible-tabs.uis"  ]
  [ "./editor.exe" "-uisCmds=test/search-hits-with-tab.uis" ]
  [ "./editor.exe" "-uisCmds=test/keysequence.uis" ]
  [ "./editor.exe" "-uisCmds=test/keysequence2.uis" ]
  [ "./editor.exe" "-uisCmds=test/screenshot-has-tabs.uis" ]
  [ "./editor.exe" "-uisCmds=test/open-files-close-docs.uis" ]
  [ "./editor.exe" "-uisCmds=test/open-files-filter.uis" ]
  [ "./editor.exe" "-uisCmds=test/cut-then-paste.uis" ]
  [ "./editor.exe" "-uisCmds=test/select-beyond-eof.uis" ]
  [ "./editor.exe" "-uisCmds=test/fn-input-repeat-tab.uis" ]
  [ "./editor.exe" "-uisCmds=test/prompt-no-unsaved.uis" ]
  [ "./editor.exe" "-uisCmds=test/apply-command-initial-focus.uis" ]
  [ "./editor.exe" "-uisCmds=test/apply-command-clear-new.uis" ]
  [ "./editor.exe" "-uisCmds=test/apply-command-history.uis" ]
  [ "./editor.exe" "-uisCmds=test/inspect-file-other-window.uis" ]
  [ "./editor.exe" "-uisCmds=test/inspect-decl-other-window.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-all-uses.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-all-uses-other-window.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-all-uses-not-open-file.uis" ]
  [ "./editor.exe" "-uisCmds=test/undo-justify.uis" ]
  [ "./editor.exe" "-uisCmds=test/apply-command-same-text.uis" ]
  [ "./editor.exe" "-uisCmds=test/apply-command-nonzero-exit.uis" ]
  [ "./editor.exe" "-uisCmds=test/apply-command-stderr.uis" ]
  [ "./editor.exe" "-uisCmds=test/apply-command-stderr-nonzero-exit.uis" ]
  [ "./editor.exe" "-uisCmds=test/apply-command-buddy-shortcut.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-go-to-decl-tabs.uis" ]
  [ "./editor.exe" "-uisCmds=test/filename-input-mkdir.uis" ]
  [ "./editor.exe" "-uisCmds=test/filename-input-refresh.uis" ]
  [ "./editor.exe" "-uisCmds=test/inspect-file-same-window.uis" ]
  [ "./editor.exe" "-uisCmds=test/inspect-file-no-candidates.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-save-as.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-arbitrary-requests.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-reload-file.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-no-op-change.uis" ]
  [ "./editor.exe" "-uisCmds=test/set-document-type.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-stop-server.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-start-server-other-language.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-go-to-decl-bad-loc.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-go-to-decl-bad-file.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-set-document-type.uis" ]
  [ "./editor.exe" "-uisCmds=test/view-highlight-trailws.uis" ]
  [ "./editor.exe" "-uisCmds=test/help-debug-open-log-file.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-dump-details.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-mgr-simple-lifecycle.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-mgr-open-after-start.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-mgr-multiple-servers.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-mgr-live-update.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-mgr-stop-server.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-mgr-start-server.uis" ]
  [ "./editor.exe" "-uisCmds=test/click-drag-beyond-eol.uis" ]
  [ "./editor.exe" "-uisCmds=test/edit-as-c-escapes.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-fix-available1.uis" ]
  [ "./editor.exe" "-uisCmds=test/lsp-diagnostic-loc.uis" ]

  // This test also touches `gets-modified.txt`, so goes last.
  [ "./editor.exe" "-uisCmds=test/reload-from-files-dialog.uis" ]
]

// EOF
